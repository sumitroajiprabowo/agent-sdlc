{
  "name": "feature",
  "steps": [
    {
      "id": "clarify",
      "type": "agent",
      "role": "tech-lead",
      "needs": [],
      "artifacts": ["plan.md"]
    },
    {
      "id": "design",
      "type": "agent",
      "role": "tech-lead",
      "needs": ["clarify"],
      "artifacts": ["contracts/api.md"]
    },
    {
      "id": "design-review",
      "type": "agent",
      "role": "panel",
      "panel": ["backend", "frontend", "mobile", "qa"],
      "needs": ["design"],
      "artifacts": ["design-review.md"]
    },
    {
      "id": "gate-design",
      "type": "gate",
      "needs": ["design-review"]
    },
    {
      "id": "backend",
      "type": "agent",
      "role": "backend",
      "needs": ["gate-design"],
      "artifacts": ["backend-report.md"]
    },
    {
      "id": "frontend",
      "type": "agent",
      "role": "frontend",
      "needs": ["gate-design"],
      "artifacts": ["frontend-report.md"]
    },
    {
      "id": "mobile",
      "type": "agent",
      "role": "mobile",
      "needs": ["gate-design"],
      "artifacts": ["mobile-report.md"]
    },
    {
      "id": "integrate",
      "type": "agent",
      "role": "tech-lead",
      "needs": ["backend", "frontend", "mobile"],
      "artifacts": ["integrate-report.md"],
      "on_fail": "owner"
    },
    {
      "id": "checks",
      "type": "script",
      "run": "npm run lint && npm run typecheck && npm test",
      "needs": ["integrate"],
      "on_fail": "owner"
    },
    {
      "id": "review",
      "type": "agent",
      "role": "reviewer",
      "needs": ["checks"],
      "on_fail": "owner"
    },
    {
      "id": "security",
      "type": "agent",
      "role": "security",
      "needs": ["checks"],
      "on_fail": "owner"
    },
    {
      "id": "qa",
      "type": "agent",
      "role": "qa",
      "needs": ["review", "security"],
      "artifacts": ["qa-report.md"],
      "on_fail": "owner"
    },
    {
      "id": "release-plan",
      "type": "agent",
      "role": "devops",
      "needs": ["qa"],
      "artifacts": ["release-plan.md"]
    },
    {
      "id": "gate-accept",
      "type": "gate",
      "needs": ["release-plan"]
    }
  ]
}
