{
  "name": "bugfix",
  "steps": [
    {
      "id": "reproduce",
      "type": "agent",
      "role": "qa",
      "needs": [],
      "artifacts": ["reproduce-report.md"]
    },
    {
      "id": "fix",
      "type": "agent",
      "role": "backend",
      "needs": ["reproduce"],
      "artifacts": ["backend-report.md"]
    },
    {
      "id": "checks",
      "type": "script",
      "run": "npm run lint && npm run typecheck && npm test",
      "needs": ["fix"],
      "on_fail": "fix"
    },
    {
      "id": "review",
      "type": "agent",
      "role": "reviewer",
      "needs": ["checks"],
      "on_fail": "fix"
    },
    {
      "id": "gate-accept",
      "type": "gate",
      "needs": ["review"]
    }
  ]
}
